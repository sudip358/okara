{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "okara",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "okara", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }
  ],
  "workflows": [
    { "name": "okara-agent-run", "binding": "AGENT_RUN", "class_name": "AgentRunWorkflow" }
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "ENVIRONMENT": "production",
    "APP_ORIGIN": "https://REPLACE_WITH_APP_ORIGIN",
    "DEMO_MODE": "false",
    "TYPESAFE_MODEL": "jev-latest",
    "GEMINI_MODEL": "",
    "PERPLEXITY_MODEL": "",
    "WRITER_PROVIDER": "",
    "WRITER_MODEL": ""
  },
  "observability": { "enabled": true },
  // Requires Workers Paid ($5/month). Agent runs need more than the free plan's 10 ms CPU per step.
  // cpu_ms caps each invocation/Workflow step at 60 s; subrequests is a safety cap below the 10,000 default.
  "limits": { "cpu_ms": 60000, "subrequests": 2000 }
  // Secrets (wrangler secret put): GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, TOKEN_ENCRYPTION_KEY_V1,
  // SESSION_SECRET, and optional operator keys TYPESAFE_API_KEY, GEMINI_API_KEY, PERPLEXITY_API_KEY, WRITER_API_KEY.
}
