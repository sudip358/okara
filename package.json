{
  "name": "okara",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Two-agent SEO/GEO SaaS: evidence-backed SEO recommendations and API-sampled AI visibility tracking.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply okara --local",
    "db:migrate:remote": "wrangler d1 migrations apply okara --remote",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.130.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "hono": "^4.13.12",
    "htmlparser2": "^12.0.0",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.3",
    "@cloudflare/workers-types": "^5.20260930.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.145.0"
  }
}
