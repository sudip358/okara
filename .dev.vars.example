# Copy to .dev.vars for local development. Never commit .dev.vars.
ENVIRONMENT=development
APP_ORIGIN=http://localhost:5173
DEMO_MODE=true
# Local-only auth bypass for demo exploration. Refused unless ENVIRONMENT=development.
DEV_AUTH_BYPASS=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY_V1=
SESSION_SECRET=
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
GEMINI_API_KEY=
# Exact model id from https://ai.google.dev/gemini-api/docs/models (required; no default)
GEMINI_MODEL=
PERPLEXITY_API_KEY=
# Agent API model in provider/model form, e.g. perplexity/sonar (see https://docs.perplexity.ai)
PERPLEXITY_MODEL=
# Writer: WRITER_PROVIDER=anthropic|openai_compatible, exact model id required
WRITER_PROVIDER=
WRITER_MODEL=
WRITER_API_KEY=
WRITER_BASE_URL=
