# Copy to .dev.vars for local development. Never commit .dev.vars.
ENVIRONMENT=development
APP_ORIGIN=http://localhost:5173
DEMO_MODE=true
# Local-only auth bypass for demo exploration. Refused unless ENVIRONMENT=development.
DEV_AUTH_BYPASS=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY_V1=
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
GEMINI_API_KEY=
# Exact model id from https://ai.google.dev/gemini-api/docs/models (required; no default)
GEMINI_MODEL=
PERPLEXITY_API_KEY=
# Agent API model in provider/model form, e.g. perplexity/sonar (see https://docs.perplexity.ai)
PERPLEXITY_MODEL=
# OpenAI GEO lane (Responses API + web_search). Separate from the writer key. Exact model id required, e.g. one
# the web search guide lists (https://developers.openai.com/api/docs/guides/tools-web-search); no default.
OPENAI_GEO_API_KEY=
OPENAI_GEO_MODEL=
# Anthropic GEO lane (Messages API + web_search_20250305). Separate from WRITER_API_KEY. Exact model id required.
ANTHROPIC_GEO_API_KEY=
ANTHROPIC_GEO_MODEL=
# Optional operator DataForSEO API login + API password (competitor data; paid per request; global caps apply).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Writer: WRITER_PROVIDER=anthropic|openai_compatible, exact model id required
WRITER_PROVIDER=
WRITER_MODEL=
WRITER_API_KEY=
# Required for openai_compatible (https only), e.g. https://api.openai.com/v1
WRITER_BASE_URL=
# Optional, openai_compatible reasoning models only: none|minimal|low|medium|high|xhigh|max
WRITER_REASONING_EFFORT=
# Optional, openai_compatible only: extra max_completion_tokens for reasoning (whole number 0-100000).
# Empty = 0 without WRITER_REASONING_EFFORT, 4000 with it.
WRITER_REASONING_HEADROOM_TOKENS=
# Optional Gemini thinkingLevel override: MINIMAL|LOW|MEDIUM|HIGH (any model id) or OFF.
# Empty = LOW for Gemini 3+ ids and gemini-flash-latest / gemini-pro-latest, nothing for older models.
GEMINI_THINKING_LEVEL=
# Sign-in allowlist (comma-separated). Empty = anyone outside production; production refuses everyone until set.
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=
# Daily caps across all projects on the operator keys above. Empty = code defaults (src/worker/runs/budget.ts):
# 2000000 usd micros ($2.00), 2000 Jev calls, 3000 provider calls, 1000000 writer tokens.
GLOBAL_USD_MICROS_PER_DAY=
GLOBAL_JEV_CALLS_PER_DAY=
GLOBAL_PROVIDER_CALLS_PER_DAY=
GLOBAL_WRITER_TOKENS_PER_DAY=
# Non-brand GSC queries in scope of the buyer-queries view. Empty = 5000 (code default); clamped to 20000.
BUYER_QUERIES_MAX=
# Daily browser-time cap (ms) for backlink browser re-checks (Browser Run binding BROWSER in wrangler.jsonc).
# Empty = 480000 (8 of the free 10 minutes per day); clamped to 540000; 0 = off. Without "remote": true on the
# binding, local dev may have no real browser: re-checks then end as "browser unavailable" (plain result kept).
BACKLINK_BROWSER_MS_PER_DAY=
